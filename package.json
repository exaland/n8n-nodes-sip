{
  "name": "n8n-nodes-sip",
  "version": "0.1.0",
  "description": "n8n community node to trigger SIP calls through an HTTP SIP worker",
  "license": "MIT",
  "author": "Exaland Concept - Alexandre MAGNIER",
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "npm run build -- --watch",
    "lint": "eslint nodes credentials --ext .ts",
    "format": "prettier --write nodes credentials worker/src",
    "worker:dev": "tsx worker/src/server.ts",
    "worker:build": "tsc -p worker/tsconfig.json"
  },
  "files": [
    "dist",
    "nodes",
    "credentials",
    "README.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SipWorkerApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SipCall/SipCall.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^8.57.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.82.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "tsx": "^4.19.0"
  },
  "dependencies": {
    "axios": "^1.7.7"
  }
}
